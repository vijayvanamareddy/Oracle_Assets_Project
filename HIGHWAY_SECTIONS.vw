CREATE OR REPLACE VIEW WH_ASSETS.HIGHWAY_SECTIONS
BEQUEATH DEFINER
AS 
SELECT AADT,
           AADT_TYPE,
           AADT_TYPE_DESCR,
           AADT_YEAR,
           ABN,
           ABN_DESCR,
           ACCESS_CONTROL,
           ACCESS_CONTROL_DESCR,
           AGENCY,
           AGENCY_DESCR,
           RS.BEGIN_ELEMENT_MILEPOINT,
           BEGIN_NODE_DESCRIPTION,
           BEGIN_NODE_ID,
           RS.BEGIN_OFFSET,
           RS.BEGIN_SECTION_MP,
           BRIDGE_POSTING_CSL,
           BRIDGE_RELIABILITY_CSL,
           CAPACITY,
           CENTER_TURN_LANE_COUNT,
           CENTER_TURN_LANE_WIDTH,
           CONDITION_CSL,
           CONGESTION_CSL,
           CONGESTION_RATE_CSL,
           COUNTY_CODE,
           COUNTY_NAME,
           CRASH_HISTORY_CSL,
           CRASH_HISTORY_RATE_CSL,
           CSL_YEAR,
           RS.CUMULATIVE_MILEPOINT_ORDER,
           DIRECTION,
           DIRECTIONAL_SUFFIX,
           RS.ELEMENT_ID,
           ELEMENT_WID,
           ELEMENT_LENGTH,
           RS.END_SECTION_MP,
           RS.END_ELEMENT_MILEPOINT,
           END_NODE_DESCRIPTION,
           END_NODE_ID,
           RS.END_OFFSET,
           EXISTING,
           FACTORED_AADT,
           FACTOR_GROUP,
           FACTOR_YEAR,
           FEDERAL_FUNCTIONAL_CLASS,
           FEDERAL_FUNCTIONAL_CLASS_DESCR,
           FEDERAL_URBAN_GROUP,
           FEDERAL_URBAN_GROUP_DESCR,
           FEDERAL_URBAN_RURAL,
           FEDERAL_URBAN_RURAL_DESCR,
           FUTURE_ADT,
           FUTURE_ADT_YEAR,
           HASS_DESCRIPTION,
           HASS_ID,
           HPMS_SECTION_ID,
           ELEMENT_WID,                                -- Replaces HIGHWAY_ID,
           HUNDRED_MILLION_VEHICLE_MILES,
           IRI,
           JURISDICTION,
           JURISDICTION_ABBREVIATION,
           JURISDICTION_CODE,
           LANE_COUNT,
           LANE_SURFACE_TYPE,
           LANE_SURFACE_TYPE_DESCR,
           LEFT_LANE_CROSSSECTION,
           LEFT_RUT,
           LEFT_SHOULDER_TYPE,
           LEFT_SHOULDER_TYPE_DESCR,
           LEFT_SHOULDER_WIDTH,
           LEFT_TURN_LANE_COUNT,
           LEFT_TURN_LANE_WIDTH,
           MAINT_RESP_WINTER,
           MAINT_RESP_WINTER_DESCR,
           MAINT_RESP_YEARROUND,
           MAINT_RESP_YEAR_DESCR,
           MEAN_SUM_DEFLECTION_CSL,
           MEDIAN_AVERAGE_WIDTH,
           MEDIAN_TYPE,
           MEDIAN_TYPE_DESCR,
           MIN_PAVEMENT_WIDTH_CSL,
           MIN_STRUCT_BRIDGE_COND_CSL,
           MPO,
           NATIONAL_TRUCK_NETWORK,
           NATIONAL_TRUCK_NETWORK_DESCR,
           NHS_STATUS,
           NHS_TYPE,
           NHS_TYPE_DESCR,
           LANE_COUNT,
           OFFICIAL_MILES,
           ONE_WAY,
           ONE_WAY_DESCR,
           OWNER,
           OWNER_DESCR,
           PAVEMENT_CONDITION_CSL,
           PAVEMENT_RUTTING_CSL,
           PAVEMENT_WIDTH_CSL,
           PCR,
           PLOW_CREW,
           PMS_FILE_NAME,
           PMS_INVENTORY_YEAR,
           PRIMARY,
           PRIMARY_ROUTE_NAME,
           rs.PRIMARY_ROUTE_NUMBER,
           PRIORITY,
           RAMP,
           RAMP_DESCR,
           MAINTENANCE_REGION,
           MAINTENANCE_REGION_DESCR,
           RIDE_QUALITY_CSL,
           RIGHT_LANE_CROSSSECTION,
           RIGHT_RUT,
           RIGHT_SHOULDER_TYPE,
           RIGHT_SHOULDER_TYPE_DESCR,
           RIGHT_SHOULDER_WIDTH,
           RIGHT_TURN_LANE_COUNT,
           RIGHT_TURN_LANE_WIDTH,
           ROADWAY_STRENGTH_CSL,
           ROADWAY_TYPE,
           ROADWAY_TYPE_DESCR,
           ROAD_POSTING_CSL,
           ROUTE_GROUP,
           ROUTE_NAME,
           RS.ROUTE_NUMBER,
           ROUTE_TYPE,
           ROUTE_SYSTEM,
           RUT_CSL,
           SAFETY_CSL,
           SCENIC_BYWAY_DESCRIPTION,
           SCENIC_BYWAY_DESIG_YR,
           SCENIC_BYWAY_NAME,
           SCENIC_BYWAY_TYPE,
           SCENIC_BYWAY_TYPE_DESCR,
           RS.SECTION_ID,
           SECTION_LENGTH,
           SERVICE_CSL,
           SH_SA_IR_DESIGNATION,
           SPEED,
           SPEEDSRC,
           SPEEDZN_ID,
           SPUR_NUMBER,
           STATE_DESIGNATION_NUMBER,
           STATE_DESIG_TYPE,
           STATE_DESIG_TYPE_DESCR,
           STATE_URBAN_RURAL,
           STATE_URBAN_RURAL_DESCR,
           STRATEGIC_HIGHWAY_NETWORK,
           STRATEGIC_HIGHWAY_NETWORK_DESC,
           RS.STREET_NAME,
           STREET_NAME_PREFIX,
           STREET_NAME_SUFFIX,
           TRIM (
                  STREET_NAME_PREFIX
               || ' '
               || RS.STREET_NAME
               || ' '
               || STREET_NAME_SUFFIX),
 --          STREET_SEQ_NO,
           STRUCT_BRIDGE_COND_CSL,
           SUMMER_CREW,
           THRU_LANE_COUNT,
           THRU_LANE_WIDTH,
           TOTAL_PAVEMENT_WIDTH,
           RS.TOWN,
           TOWN_CODE,
           TRANSPORTATION_MODE,
           TRUCK_LANE_COUNT,
           TRUCK_LANE_WIDTH,
           TRUCK_PERCENT,
           WCSH_AGREEMENT,
           WCSH_CODE,
           WEIGHTED_IRI_CSL,
           WEIGHTED_PCR_CSL,
           WIDTH,
           WINTER_CREW
      FROM route_sections  RS
 --          LEFT OUTER JOIN street_sections ss
 --              ON     rs.section_id = ss.section_id
 --                 AND rs.primary_route_number = ss.primary_route_number
     WHERE primary = 'Y' AND route_type IN ('N', 'I');
