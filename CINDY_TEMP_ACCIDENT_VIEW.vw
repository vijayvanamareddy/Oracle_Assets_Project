           --           ROADWAY_SECTIONS.PMS_INVENTORY_YEAR,
           --           ROADWAY_SECTIONS.PRIORITY,
           --           HIGHWAYS.RAMP,
           --           HIGHWAYS.RAMP_DESCR,
           --           ROADWAY_SECTIONS.RECOMMENDATION_DATE,
           --           ROADWAY_SECTIONS.RECOMMENDED_NEXT_TREATMENT,
           --           ROADWAY_SECTIONS.RECOMMENDED_TREATMENT_YEAR,
           --           HIGHWAYS.REGION,
           --           HIGHWAYS.REGION_DESCR,
           --           ROADWAY_SECTIONS.RIDE_QUALITY_CSL,
           --           ROADWAY_SECTIONS.RIGHT_RUT,
           --           ROADWAY_SECTIONS.RIGHT_SHOULDER_TYPE,
           --           ROADWAY_SECTIONS.RIGHT_SHOULDER_TYPE_DESCR,
           --           ROADWAY_SECTIONS.RIGHT_SHOULDER_WIDTH,
           --           ROADWAY_SECTIONS.ROADWAY_STRENGTH_CSL,
           --           ROADWAY_SECTIONS.ROADWAY_TYPE,
           --           ROADWAY_SECTIONS.ROADWAY_TYPE_DESCR,
           --           ROADWAY_SECTIONS.ROAD_POSTING_CSL,
           --           HIGHWAYS.ROUTE_SYSTEM,
           --           HIGHWAYS.ROUTE_SYSTEM_DESCR,
           --           ROADWAY_SECTIONS.RUT_CSL,
           --           ROADWAY_SECTIONS.SAFETY_CSL,
           --           ROADWAY_SECTIONS.SCENIC_BYWAY_DESCRIPTION,
           --           ROADWAY_SECTIONS.SCENIC_BYWAY_DESIG_YR,
           --           ROADWAY_SECTIONS.SCENIC_BYWAY_NAME,
           --           ROADWAY_SECTIONS.SCENIC_BYWAY_TYPE,
           --           ROADWAY_SECTIONS.SCENIC_BYWAY_TYPE_DESCR,
           --           ROADWAY_SECTIONS.SECTION_LENGTH,
           --           ROADWAY_SECTIONS.SERVICE_CSL,
           --           ROADWAY_SECTIONS.SPEED_ZONE,
           --           ROADWAY_SECTIONS.STATE_DESIG_TYPE,
           --           ROADWAY_SECTIONS.STATE_DESIG_TYPE_DESCR,
           --           ROADWAY_SECTIONS.STATE_URBAN_RURAL,
           --           ROADWAY_SECTIONS.STATE_URBAN_RURAL_DESCR,
           --           ROADWAY_SECTIONS.STREET_NAME,
           --           ROADWAY_SECTIONS.STREET_NAME_PREFIX,
           --           ROADWAY_SECTIONS.STREET_NAME_SUFFIX,
           --           ROADWAY_SECTIONS.STRUCT_BRIDGE_COND_CSL,
           --           ROADWAY_SECTIONS.SUMMER_CREW,
           --           ROADWAY_SECTIONS.THRU_LANE_COUNT,
           --           ROADWAY_SECTIONS.TOTAL_PAVEMENT_WIDTH,
           --           ROADWAY_SECTIONS.TRUCK_PERCENT,
           --           ROADWAY_SECTIONS.WEIGHTED_IRI_CSL,
           --           ROADWAY_SECTIONS.WEIGHTED_PCR_CSL,
           --           ROADWAY_SECTIONS.WIDTH,
           --           ROADWAY_SECTIONS.WINTER_CREW,
           --           ROADWAY_SECTIONS.YEAR_OF_LAST_WORK,
           --           NULL,                                         -- COLUMNS FROM NODES
           --           NULL,
           --           NULL,
           --           NULL,
           --           NULL,
           ROUTE_SECTIONS.ROUTE_NUMBER,
          ROUTE_SECTIONS.ROUTE_NAME,
           --           CASE
           --               WHEN ROUTE_SECTIONS.direction = 1
           --               THEN
           --                   ROUND (
           --                         ROUTE_SECTIONS.begin_element_milepoint
           --                       + ACCIDENTS.OFFSET,
           --                       2)
           --               WHEN ROUTE_SECTIONS.direction = -1
           --               THEN
           --                   ROUND (
           --                         ROUTE_SECTIONS.end_element_milepoint
           --                       - ACCIDENTS.OFFSET,
           --                       2)
           --           END
           --               "Milepoint",
           --           NULL, --       JURISDICTION  (IN NODES TABLE, BUT NOT IN ROADWAY_SECTIONS YET),
           --           ROADWAY_SECTIONS.CREATED_BY,
           --           ROADWAY_SECTIONS.DATE_CREATED,
           --           ROADWAY_SECTIONS.DATE_MODIFIED,
           --           ROADWAY_SECTIONS.END_DATE,
           --           ROADWAY_SECTIONS.MODIFIED_BY,
           --           ROADWAY_SECTIONS.SNAPSHOT_YEAR,
           --           ROADWAY_SECTIONS.START_DATE,
           --           ROADWAY_SECTIONS.STATE
           route_sections.route_number   AS route_sections_route_number,
           wh_common.dim_routes.route_number AS dim_routes_route_number
      FROM ACCIDENTS
           LEFT OUTER JOIN elements
               ON ACCIDENTS.element_wid = elements.element_wid
           LEFT OUTER JOIN SECTIONS
               ON ACCIDENTS.SECTION_ID = SECTIONS.SECTION_ID
           LEFT OUTER JOIN ROUTE_SECTIONS
               ON SECTIONS.SECTION_ID = ROUTE_SECTIONS.SECTION_ID
           LEFT OUTER JOIN wh_common.dim_routes
               ON route_sections.route_number =
                  wh_common.dim_routes.route_number
     WHERE                                     --accidents.element_id = 227438
               -- ACCIDENTS.LOCATION_TYPE = 'ELEMENT'
               --       AND wh_common.dim_routes.route_system <> 'PMS ROUTE'
               accidents.element_id IS NOT NULL
           AND ACCIDENTS.mdotid IN ('2013-10229',
