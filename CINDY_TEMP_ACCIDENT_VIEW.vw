CREATE OR REPLACE VIEW WH_ASSETS.CINDY_TEMP_ACCIDENT_VIEW
BEQUEATH DEFINER
AS 
SELECT                                          --ACCIDENTS.ACCIDENT_DATE,
           --           ACCIDENTS.ACCIDENT_DAY_OF_WEEK,
           --           ACCIDENTS.ACCIDENT_DAY_OF_WEEK_NUM,
           --           ACCIDENTS.ACCIDENT_HOUR,
           --           ACCIDENTS.ACCIDENT_MONTH_NAME,
           --           ACCIDENTS.ACCIDENT_MONTH_NUM,
           --           ACCIDENTS.ACCIDENT_TIME,
           --           ACCIDENTS.ACCIDENT_YEAR,
           --           ACCIDENTS.CONTRIB_CIRC_ENV1,
           --           ACCIDENTS.CONTRIB_CIRC_ENV1_DESCR,
           --           ACCIDENTS.CONTRIB_CIRC_ENV2,
           --           ACCIDENTS.CONTRIB_CIRC_ENV2_DESCR,
           --           ACCIDENTS.CONTRIB_CIRC_ROAD1,
           --           ACCIDENTS.CONTRIB_CIRC_ROAD1_DESCR,
           --           ACCIDENTS.CONTRIB_CIRC_ROAD2,
           --           ACCIDENTS.CONTRIB_CIRC_ROAD2_DESCR,
           --           ACCIDENTS.COUNTY_CODE,
           --           ACCIDENTS.COUNTY_NAME,
           --           ACCIDENTS.CRASH_COST,
           ACCIDENTS.ELEMENT_ID,
           --           ACCIDENTS.FEDERAL_URBAN_GROUP,
           --           ACCIDENTS.FEDERAL_URBAN_GROUP_DESCR,
           ACCIDENTS.element_wid,
           --           ACCIDENTS.INJURY_COUNT,
           --           ACCIDENTS.INJURY_LEVEL,
           --           ACCIDENTS.INJURY_LEVEL_CODE,
           --           ACCIDENTS.LATITUDE,
           --           ACCIDENTS.LIGHT_CONDITION,
           --           ACCIDENTS.LIGHT_CONDITION_DESCR,
           ACCIDENTS.LOCATION_TYPE,
           --           ACCIDENTS.LOC_FIRST_HARMFUL_EVENT,
           --           ACCIDENTS.LOC_FIRST_HARMFUL_EVENT_DESCR,
           --           ACCIDENTS.LONGITUDE,
           ACCIDENTS.MDOTID,
           ACCIDENTS.NODE_ID,
           --           ACCIDENTS.NO_OF_A_INJ,
           --           ACCIDENTS.NO_OF_B_INJ,
           --           ACCIDENTS.NO_OF_C_INJ,
           --           ACCIDENTS.NO_OF_K_INJ,
           --           ACCIDENTS.NO_OF_NON_INJ,
           --           ACCIDENTS.OFFSET,
           --           ACCIDENTS.PRIMARY_ROUTE_MP,
           --           ACCIDENTS.PRIMARY_ROUTE_NAME,
           --           ACCIDENTS.PRIMARY_ROUTE_NUMBER,
           --           ACCIDENTS.REGION_CODE,
