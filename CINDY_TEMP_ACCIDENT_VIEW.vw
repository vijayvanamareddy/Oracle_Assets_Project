           --           ACCIDENTS.TYPE_OF_LOCATION_DESCR,
           --           ACCIDENTS.WEATHER_CONDITION,
           --           ACCIDENTS.WEATHER_CONDITION_DESCR,
           --           ACCIDENTS.WORKZONE_IN_OR_NEAR,
           --           ACCIDENTS.WORKZONE_IN_OR_NEAR_DESCR,
           --           ACCIDENTS.WORKZONE_LOCATION,
           --           ACCIDENTS.WORKZONE_LOCATION_DESCR,
           --           ACCIDENTS.WORKZONE_POLICE_PRESENT,
           --           ACCIDENTS.WORKZONE_POLICE_PRESENT_DESCR,
           --           ACCIDENTS.WORKZONE_TYPE,
           --           ACCIDENTS.WORKZONE_TYPE_DESCR,
           --           ACCIDENTS.WORKZONE_WORKERS_PRESENT,
           --           ACCIDENTS.WORKZONE_WORKERS_PRESENT_DESCR,
           --           ROADWAY_SECTIONS.AADT,
           --           ROADWAY_SECTIONS.AADT_TYPE,
           --           ROADWAY_SECTIONS.AADT_TYPE_DESCR,
           --           ROADWAY_SECTIONS.AADT_YEAR,
           --           ROADWAY_SECTIONS.ABN,
           --           ROADWAY_SECTIONS.ABN_DESCR,
           --           ROADWAY_SECTIONS.ACCESS_CONTROL,
           --           ROADWAY_SECTIONS.ACCESS_CONTROL_DESCR,
           --           ROADWAY_SECTIONS.AGENCY,
           --           ROADWAY_SECTIONS.AGENCY_DESCR,
           --           ROADWAY_SECTIONS.BEGIN_OFFSET,             -- BEGIN_SECTION_OFFSET,
           --           ROUTE_SECTIONS.BEGIN_SECTION_MP,
           --           ROADWAY_SECTIONS.BRIDGE_POSTING_CSL,
           --           ROADWAY_SECTIONS.BRIDGE_RELIABILITY_CSL,
           --           ROADWAY_SECTIONS.CAPACITY,
           --           ROADWAY_SECTIONS.CONDITION_CSL,
           --           ROADWAY_SECTIONS.CONGESTION_CSL,
           --           ROADWAY_SECTIONS.CONGESTION_RATE_CSL,
           --           ROADWAY_SECTIONS.CRASH_HISTORY_CSL,
           --           ROADWAY_SECTIONS.CRASH_HISTORY_RATE_CSL,
           --           ROADWAY_SECTIONS.CSL_YEAR,
           --           ROUTE_SECTIONS.CUMULATIVE_MILEPOINT_ORDER,
           --           ROADWAY_SECTIONS.DEFENSE_HIGHWAY,
           --           ROADWAY_SECTIONS.DEFENSE_HIGHWAY_DESCR,
           --           HIGHWAYS.DIRECTIONAL_SUFFIX,
           --           HIGHWAYS.ELEMENT_LENGTH,
           --           ROADWAY_SECTIONS.END_OFFSET,                 -- END_SECTION_OFFSET,
           --           ROUTE_SECTIONS.END_SECTION_MP,
           --           HIGHWAYS.EXISTING,
           --           ROADWAY_SECTIONS.FACTORED_AADT,
           --           HIGHWAYS.FACTOR_GROUP,
           --           ROADWAY_SECTIONS.FACTOR_YEAR,
           --           ROADWAY_SECTIONS.FEDERAL_FUNCTIONAL_CLASS,
           --           ROADWAY_SECTIONS.FEDERAL_FUNCTIONAL_CLASS_DESCR,
           --           ROADWAY_SECTIONS.FEDERAL_URBAN_RURAL,
           --           ROADWAY_SECTIONS.FEDERAL_URBAN_RURAL_DESCR,
           --           ROADWAY_SECTIONS.FUTURE_ADT,
           --           ROADWAY_SECTIONS.FUTURE_ADT_YEAR,
           --           ROADWAY_SECTIONS.HASS_DESCRIPTION,
           --           ROADWAY_SECTIONS.HUNDRED_MILLION_VEHICLE_MILES,
           --           ROADWAY_SECTIONS.IRI,
           --           ROADWAY_SECTIONS.LANE_COUNT,
           --           ROADWAY_SECTIONS.LEFT_RUT,
           --           ROADWAY_SECTIONS.LEFT_SHOULDER_TYPE,
           --           ROADWAY_SECTIONS.LEFT_SHOULDER_TYPE_DESCR,
