CREATE OR REPLACE PROCEDURE load_crashes_on_route
IS
    /**********************************************************************
    This procedure loads the CRASHES_ON_ROUTE table which is a full outer join of the highway network with the crashes.
    It replaces the materialized view mv_crashes_on_route

    It truncates the table and re-loads it.

    04-12-2019 SH  Initial Version
    11-06-2019 SH  Add new columns from accidents and SNAPSHOT_YEAR,
                   MDOT_REVIEW_DATE, MDOT_LAST_MODIFIED, MDOT_REVIEWER_ID, MDOT_REVIEW_COMMENT requested by Shawn Hembree
                   CRASHREPORTID - requested by Tom Marcotte
                   BICYCLE_YN ,PEDESTRIAN_YN,NO_OF_UNITS , NO_OF_PERSONS   - added for mapviewer - Requested by Shawn Macdonald
    12-22-2019  SH Moved new version to production
    04-05-2020 SH Lookup snapshot year from complete_transportation_network instead of hardcode it
    07-20-2020 SH Add sidewalks  LEFT_SIDEWALK_TYPE, LEFT_SIDEWALK_TYPE_DESCR, LEFT_SIDEWALK_WIDTH, RIGHT_SIDEWALK_TYPE,
                  RIGHT_SIDEWALK_TYPE_DESCR, RIGHT_SIDEWALK_WIDTH
    04-05-2021 SH Add secondary_crash column 
    06-16-2021 SH Add columns FED_AID, LAST_TREATMENT_PSN
    09-01-2022 SH Add column FARS_YN to indicate if the crash is considered a fars fatility JIRA task dotdw-640    
    09-14-2022 SH Add MOTORCYCLE_YN Unit types 11 (Motorcycle), 12  (Moped) Jira Task: DOTDW-640  
    02-27-2204 DG  Add columns BASE_AS_BUILT_HMA, BASE_GRAN_THICK, BASE_GRAN_TYPE, BASE_GRAN_TYPE_DESCR, BASE_MISC_THICK, BASE_MISC_TYPE, BASE_MISC_TYPE_DESCR, 
                               BASE_MOD_TYPE, BASE_MOD_TYPE_DESCR, BASE_MOD_YR, BASE_PRI_ID_TYPE, BASE_PRI_ID_TYPE_DESCR, BASE_PRIMARY_ID, BASE_PRIMARY_WIN,                
                               BASE_SEC_ID_TYPE, BASE_SEC_ID_TYPE_DESCR, BASE_SECOND_ID, BASE_SUB_THICK, 
                               EXCEPTIONS_DESC_XXX, FACTORED_AADT_CALC_COMMENT, 
                               HPMT_COMB_AADT_PCNT, HPMT_COMB_DHV_PCNT, HPMT_DHV_PCNT, HPMT_DIR_DIST, HPMT_PASS_AADT_PCNTc, HPMT_PASS_DHV_PCNT, HPMT_SU_AADT_PCNT, HPMT_SU_DHV_PCNT
                               NHFN_CONNECTOR_ID, NHFN_SUBSYSTEM, NHFN_SUBSYSTEM_DESCR, SLD_FILE_DATE, SLD_FILE_NAME  
    **********************************************************************/



    commit_count   NUMBER (7) := 0;
    cntr           NUMBER (7) := 0;
    snap_year      NUMBER;

    g_start_time   DATE := SYSDATE;
    g_owner        VARCHAR2 (20) := 'WH_ASSETS';
    g_jobname      VARCHAR2 (30) := 'LOAD_CRASHES_ON_ROUTE';
    g_object       VARCHAR2 (20) := 'CRASHES_ON_ROUTE';
    g_sqlmsg       VARCHAR2 (500) := NULL;



    CURSOR acc
    IS
        SELECT A.ACCIDENT_DATE,
               A.ACCIDENT_DAY_OF_WEEK,
               A.ACCIDENT_DAY_OF_WEEK_NUM,
               A.ACCIDENT_HOUR,
               A.ACCIDENT_MONTH_NAME,
               A.ACCIDENT_MONTH_NUM,
               A.ACCIDENT_TIME,
               A.ACCIDENT_YEAR,
               A.BICYCLE_YN,
               A.CONTRIB_CIRC_ENV1,
               A.CONTRIB_CIRC_ENV1_DESCR,
               A.CONTRIB_CIRC_ENV2,
               A.CONTRIB_CIRC_ENV2_DESCR,
               A.CONTRIB_CIRC_ROAD1,
               A.CONTRIB_CIRC_ROAD1_DESCR,
               A.CONTRIB_CIRC_ROAD2,
               A.CONTRIB_CIRC_ROAD2_DESCR,
               A.COUNTY_CODE,
               A.COUNTY_NAME,
               A.CRASH_COST,
               A.CRASH_NODE_ID,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.ELEMENT_ID
                   ELSE H.ELEMENT_ID
               END
                   ELEMENT_ID,
               A.CRASHREPORTID,
               A.FARS_YN,
               A.FEDERAL_URBAN_GROUP,
               A.FEDERAL_URBAN_GROUP_DESCR,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.ELEMENT_WID
                   ELSE H.ELEMENT_WID
               END
                   ELEMENT_WID,
               A.INJURY_COUNT,
               A.INJURY_LEVEL,
               A.INJURY_LEVEL_CODE,
               A.LATITUDE,
               A.LIGHT_CONDITION,
               A.LIGHT_CONDITION_DESCR,
               A.LOCATION_TYPE,
               A.LOC_FIRST_HARMFUL_EVENT,
               A.LOC_FIRST_HARMFUL_EVENT_DESCR,
               A.LONGITUDE,
               A.MDOTID,
               A.MDOT_LAST_MODIFIED,
               A.MDOT_REVIEW_COMMENT,
               A.MDOT_REVIEW_DATE,
               A.MDOT_REVIEWER_ID,
               A.MOTORCYCLE_YN,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.NODE_ID
                   ELSE H.NODE_ID1
               END
                   NODE_ID,
               A.NO_OF_A_INJ,
               A.NO_OF_B_INJ,
               A.NO_OF_C_INJ,
               A.NO_OF_K_INJ,
               A.NO_OF_NON_INJ,
               A.NO_OF_PERSONS,
               A.NO_OF_UNITS,
               A.OFFSET,
               A.PEDESTRIAN_YN,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.PRIMARY_ROUTE_MP
                   ELSE H.PRIMARY_ROUTE_MP
               END
                   PRIMARY_ROUTE_MP,
               A.PRIMARY_ROUTE_NAME,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.PRIMARY_ROUTE_NUMBER
                   ELSE H.PRIMARY_ROUTE_NUMBER
               END
                   PRIMARY_ROUTE_NUMBER,
               A.REGION_CODE,
               A.REGION_NAME,
               A.REPORTING_AGENCY,
               A.REPORTING_AGENCY_DESCR,
               A.REPORT_NUMBER,
               A.ROAD_GRADE,
               A.ROAD_GRADE_DESCR,
               A.ROAD_SURF_COND,
               A.ROAD_SURF_COND_DESCR,
               A.SCHOOL_BUS_RELATED,
               A.SCHOOL_BUS_RELATED_DESCR,
               A.SECONDARY_CRASH_YN,
               H.SECTION_ID,
               A.SPEED_LIMIT,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.TOWN_CODE
                   ELSE H.TOWN_CODE1
               END
                   TOWN_CODE,
               CASE
                   WHEN A.MDOTID IS NOT NULL THEN A.TOWN_NAME
                   ELSE H.TOWN_NAME1
               END
                   TOWN_NAME,
               A.TRAFFIC_CONTROL_DEVICE,
               A.TRAFFIC_CONTROL_DEVICE_DESCR,
               A.TRF_CNTRL_DEV_OPRATIONL,
               A.TRF_CNTRL_DEV_OPRATIONL_DESCR,
               A.TYPE_OF_CRASH,
               A.TYPE_OF_CRASH_DESCR,
               A.TYPE_OF_LOCATION,
               A.TYPE_OF_LOCATION_DESCR,
               A.WEATHER_CONDITION,
               A.WEATHER_CONDITION_DESCR,
               A.WORKZONE_IN_OR_NEAR,
               A.WORKZONE_IN_OR_NEAR_DESCR,
               A.WORKZONE_LOCATION,
               A.WORKZONE_LOCATION_DESCR,
               A.WORKZONE_POLICE_PRESENT,
               A.WORKZONE_POLICE_PRESENT_DESCR,
               A.WORKZONE_TYPE,
               A.WORKZONE_TYPE_DESCR,
               A.WORKZONE_WORKERS_PRESENT,
               A.WORKZONE_WORKERS_PRESENT_DESCR,
               ROW_TYPE,
               H.AADT,
               H.AADT_TYPE,
               H.AADT_TYPE_DESCR,
               H.AADT_YEAR,
               H.ABN,
               H.ABN_DESCR,
               H.ACCESS_CONTROL,
               H.ACCESS_CONTROL_DESCR,
               H.AGENCY,
               H.AGENCY_DESCR,
               H.BASE_AS_BUILT_HMA,        
               H.BASE_GRAN_THICK,
               H.BASE_GRAN_TYPE,
               H.BASE_GRAN_TYPE_DESCR,
               H.BASE_MISC_THICK,                 
               H.BASE_MISC_TYPE,                  
               H.BASE_MISC_TYPE_DESCR,            
               H.BASE_MOD_TYPE,                   
               H.BASE_MOD_TYPE_DESCR,             
               H.BASE_MOD_YR,                     
               H.BASE_PRI_ID_TYPE,                
               H.BASE_PRI_ID_TYPE_DESCR,          
               H.BASE_PRIMARY_ID,                 
               H.BASE_PRIMARY_WIN,                
               H.BASE_SEC_ID_TYPE,                
               H.BASE_SEC_ID_TYPE_DESCR,          
               H.BASE_SECOND_ID,                  
               H.BASE_SUB_THICK,  
               H.BEGIN_ELEMENT_MILEPOINT,
               H.BEGIN_SECTION_MP,
               H.BEGIN_NODE_DESCRIPTION,
               H.BEGIN_NODE_ID,
               H.BEGIN_SECTION_OFFSET,
               H.BRIDGE_POSTING_CSL,
               H.BRIDGE_RELIABILITY_CSL,
               H.CAPACITY,
               H.CENTER_TURN_LANE_COUNT,
               H.CENTER_TURN_LANE_WIDTH,
               H.CONDITION_CSL,
               H.CONGESTION_CSL,
               H.CONGESTION_RATE_CSL,
               H.CRASH_HISTORY_CSL,
               H.CRASH_HISTORY_RATE_CSL,
               H.CSL_YEAR,
               H.CUMULATIVE_MILEPOINT_ORDER,
               H.DIRECTION,
               H.DIRECTIONAL_SUFFIX,
               H.ELEMENT_LENGTH,
               H.END_ELEMENT_MILEPOINT,
               H.END_SECTION_MP,
               H.END_NODE_DESCRIPTION,
               H.END_NODE_ID,
               H.END_SECTION_OFFSET,
               H.EXCEPTIONS_DESC_XXX,
               H.EXISTING,
               H.FACTORED_AADT,
               H.FACTORED_AADT_CALC_COMMENT,
               H.FACTOR_GROUP,
               H.FACTOR_YEAR,
               H.FED_AID,
               H.FEDERAL_FUNCTIONAL_CLASS,
               H.FEDERAL_FUNCTIONAL_CLASS_DESCR,
               H.FEDERAL_URBAN_RURAL,
               H.FEDERAL_URBAN_RURAL_DESCR,
               H.FUTURE_ADT,
               H.FUTURE_ADT_YEAR,
               H.HASS_DESCRIPTION,
               H.HASS_ID,
               H.HPMS_SECTION_ID,
               H.HPMT_COMB_AADT_PCNT,
               H.HPMT_COMB_DHV_PCNT,
               H.HPMT_DHV_PCNT,
               H.HPMT_DIR_DIST,
               H.HPMT_PASS_AADT_PCNT,
               H.HPMT_PASS_DHV_PCNT,
               H.HPMT_SU_AADT_PCNT,
               H.HPMT_SU_DHV_PCNT,
               H.HUNDRED_MILLION_VEHICLE_MILES,
               H.IRI,
               H.JURISDICTION,
               H.JURISDICTION_ABBREVIATION,
               H.JURISDICTION_CODE,
               H.LANE_COUNT,
               H.LANE_SURFACE_TYPE,
               H.LANE_SURFACE_TYPE_DESCR,
               H.LAST_TREATMENT_PSN,
               H.LEFT_LANE_CROSSSECTION,
               H.LEFT_RUT,
               H.LEFT_SHOULDER_TYPE,
               H.LEFT_SHOULDER_TYPE_DESCR,
               H.LEFT_SHOULDER_WIDTH,
               H.LEFT_SIDEWALK_TYPE,
               H.LEFT_SIDEWALK_TYPE_DESCR,
               H.LEFT_SIDEWALK_WIDTH,
               H.LEFT_TURN_LANE_COUNT,
               H.LEFT_TURN_LANE_WIDTH,
               H.MAINT_RESP_WINTER,
               H.MAINT_RESP_WINTER_DESCR,
               H.MAINT_RESP_YEARROUND,
               H.MAINT_RESP_YEAR_DESCR,
               H.MEAN_SUM_DEFLECTION_CSL,
               H.MEDIAN_AVERAGE_WIDTH,
               H.MEDIAN_TYPE,
               H.MEDIAN_TYPE_DESCR,
               H.MEV,
               H.MIN_PAVEMENT_WIDTH_CSL,
               H.MIN_STRUCT_BRIDGE_COND_CSL,
               H.MPO,
               H.NATIONAL_TRUCK_NETWORK,
               H.NATIONAL_TRUCK_NETWORK_DESCR,
               H.NHFN_CONNECTOR_ID,
               H.NHFN_SUBSYSTEM,
               H.NHFN_SUBSYSTEM_DESCR,
               H.NHS_STATUS,
               H.NHS_TYPE,
               H.NHS_TYPE_DESCR,
               H.NODE_DESCRIPTION,
               H.NO_OF_LEGS,
               H.NUMBER_OF_LANES,
               H.OFFICIAL_MILES,
               H.ONE_WAY,
               H.ONE_WAY_DESCR,
               H.OWNER,
               H.OWNER_DESCR,
               H.PAVEMENT_CONDITION_CSL,
               H.PAVEMENT_RUTTING_CSL,
               H.PAVEMENT_WIDTH_CSL,
               H.PCR,
               H.PLOW_CREW,
               H.PMS_FILE_NAME,
               H.PMS_INVENTORY_YEAR,
               H.PRIMARY,
               H.PRIORITY,
               H.RAMP,
               H.RAMP_DESCR,
               H.MAINTENANCE_REGION,
               H.MAINTENANCE_REGION_DESCR,
               H.RIDE_QUALITY_CSL,
               H.RIGHT_LANE_CROSSSECTION,
               H.RIGHT_RUT,
               H.RIGHT_SHOULDER_TYPE,
               H.RIGHT_SHOULDER_TYPE_DESCR,
               H.RIGHT_SHOULDER_WIDTH,
               H.RIGHT_SIDEWALK_TYPE,
               H.RIGHT_SIDEWALK_TYPE_DESCR,
               H.RIGHT_SIDEWALK_WIDTH,
               H.RIGHT_TURN_LANE_COUNT,
               H.RIGHT_TURN_LANE_WIDTH,
               H.ROADWAY_STRENGTH_CSL,
               H.ROADWAY_TYPE,
               H.ROADWAY_TYPE_DESCR,
               H.ROAD_POSTING_CSL,
               H.ROUTE_NAME,
               H.ROUTE_NUMBER,
               H.ROUTE_GROUP,
               H.ROUTE_SYSTEM,
               H.ROUTE_TYPE,
               H.RUT_CSL,
               H.SAFETY_CSL,
               H.SCENIC_BYWAY_DESCRIPTION,
               H.SCENIC_BYWAY_DESIG_YR,
               H.SCENIC_BYWAY_NAME,
               H.SCENIC_BYWAY_TYPE,
               H.SCENIC_BYWAY_TYPE_DESCR,
               H.SECTION_LENGTH,
               H.SERVICE_CSL,
               H.SH_SA_IR_DESIGNATION,
               H.SLD_FILE_DATE, 
               H.SLD_FILE_NAME, 
               H.SORTORD,
               h.SPEED,
               h.SPEEDSRC,
               h.SPEEDZN_ID,
               H.SPUR_NUMBER,
               H.STATE_AID_NO,
               H.STATE_DESIGNATION_NUMBER,
               H.STATE_DESIG_TYPE,
               H.STATE_DESIG_TYPE_DESCR,
               H.STATE_HIGHWAY_DESIGNATION_NUMBER,
               H.STATE_URBAN_RURAL,
               H.STATE_URBAN_RURAL_DESCR,
               H.STRATEGIC_HIGHWAY_NETWORK,
               H.STRATEGIC_HIGHWAY_NETWORK_DESC,
               H.STREET_NAME,
               H.STREET_NAME_PREFIX,
               H.STREET_NAME_SUFFIX,
               H.STREETNAME,
               H.STRUCT_BRIDGE_COND_CSL,
               H.SUMMER_CREW,
               H.THRU_LANE_COUNT,
               H.THRU_LANE_WIDTH,
               H.TOTAL_PAVEMENT_WIDTH,
               H.TOWNLINE_NODE,
               H.TRAFFIC_SIGNAL,
               H.TRANSPORTATION_MODE,
               H.TRUCK_LANE_COUNT,
               H.TRUCK_LANE_WIDTH,
               H.TRUCK_PERCENT,
               H.WCSH_AGREEMENT,
               H.WCSH_CODE,
               H.WEIGHTED_IRI_CSL,
               H.WEIGHTED_PCR_CSL,
               H.WIDTH,
               H.WINTER_CREW,
               CASE
                   WHEN a.location_type = 'ELEMENT' AND H.direction = 1
                   THEN
                       ROUND (H.begin_element_milepoint + A.OFFSET, 2)
                   WHEN a.location_type = 'ELEMENT' AND H.direction = -1
                   THEN
                       ROUND (H.end_element_milepoint - A.OFFSET, 2)
                   WHEN a.location_type = 'NODE'
                   THEN
                       H.begin_element_milepoint
                   ELSE
                       NULL
               END
                   MILEPOINT                                -- CRASH MILEPOINT
          FROM V_HIGHWAY_NETWORK  h
               FULL OUTER JOIN accidents a
                   ON (a.node_id = h.node_id1 OR a.section_id = h.section_id);
BEGIN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE CRASHES_ON_ROUTE';

    EXECUTE IMMEDIATE 'TRUNCATE TABLE CRASHES_ON_ROUTE_ERROR_LOG';

    MANAGE_INDEXES.Mark_Indexes_Unusable ('CRASHES_ON_ROUTE');

    SELECT MAX (snapshot_year)
      INTO snap_year
      FROM complete_transportation_network;

    FOR aa IN acc
    LOOP
        INSERT INTO crashes_on_route (AADT,
                                      AADT_TYPE,
                                      AADT_TYPE_DESCR,
                                      AADT_YEAR,
                                      ABN,
                                      ABN_DESCR,
                                      ACCESS_CONTROL,
                                      ACCESS_CONTROL_DESCR,
                                      ACCIDENT_DATE,
                                      ACCIDENT_DAY_OF_WEEK,
                                      ACCIDENT_DAY_OF_WEEK_NUM,
                                      ACCIDENT_HOUR,
                                      ACCIDENT_MONTH_NAME,
                                      ACCIDENT_MONTH_NUM,
                                      ACCIDENT_TIME,
                                      ACCIDENT_YEAR,
                                      AGENCY,
                                      AGENCY_DESCR,
                                      BASE_AS_BUILT_HMA,        
                                      BASE_GRAN_THICK,
                                      BASE_GRAN_TYPE,
                                      BASE_GRAN_TYPE_DESCR,
                                      BASE_MISC_THICK,                 
                                      BASE_MISC_TYPE,                  
                                      BASE_MISC_TYPE_DESCR,            
                                      BASE_MOD_TYPE,                   
                                      BASE_MOD_TYPE_DESCR,             
                                      BASE_MOD_YR,                     
                                      BASE_PRI_ID_TYPE,                
                                      BASE_PRI_ID_TYPE_DESCR,          
                                      BASE_PRIMARY_ID,                 
                                      BASE_PRIMARY_WIN,                
                                      BASE_SEC_ID_TYPE,                
                                      BASE_SEC_ID_TYPE_DESCR,          
                                      BASE_SECOND_ID,                  
                                      BASE_SUB_THICK,  
                                      BEGIN_ELEMENT_MILEPOINT,
                                      BEGIN_NODE_DESCRIPTION,
                                      BEGIN_NODE_ID,
                                      BEGIN_SECTION_MP,
                                      BEGIN_SECTION_OFFSET,
                                      BICYCLE_YN,
                                      BRIDGE_POSTING_CSL,
                                      BRIDGE_RELIABILITY_CSL,
                                      CAPACITY,
                                      CENTER_TURN_LANE_COUNT,
                                      CENTER_TURN_LANE_WIDTH,
                                      CONDITION_CSL,
                                      CONGESTION_CSL,
                                      CONGESTION_RATE_CSL,
                                      CONTRIB_CIRC_ENV1,
                                      CONTRIB_CIRC_ENV1_DESCR,
                                      CONTRIB_CIRC_ENV2,
                                      CONTRIB_CIRC_ENV2_DESCR,
                                      CONTRIB_CIRC_ROAD1,
                                      CONTRIB_CIRC_ROAD1_DESCR,
                                      CONTRIB_CIRC_ROAD2,
                                      CONTRIB_CIRC_ROAD2_DESCR,
                                      COUNTY_CODE,
                                      COUNTY_NAME,
                                      CRASH_COST,
                                      CRASH_HISTORY_CSL,
                                      CRASH_HISTORY_RATE_CSL,
                                      CRASH_NODE_ID,
                                      CRASHREPORTID,
                                      CSL_YEAR,
                                      CUMULATIVE_MILEPOINT_ORDER,
                                      DIRECTION,
                                      DIRECTIONAL_SUFFIX,
                                      ELEMENT_ID,
                                      ELEMENT_LENGTH,
                                      ELEMENT_WID,
                                      END_ELEMENT_MILEPOINT,
                                      END_NODE_DESCRIPTION,
                                      END_NODE_ID,
                                      END_SECTION_MP,
                                      END_SECTION_OFFSET,
                                      EXCEPTIONS_DESC_XXX,
                                      EXISTING,
                                      FACTORED_AADT,
                                      FACTORED_AADT_CALC_COMMENT,
                                      FACTOR_GROUP,
                                      FACTOR_YEAR,
                                      FARS_YN,
                                      FED_AID,
                                      FEDERAL_FUNCTIONAL_CLASS,
                                      FEDERAL_FUNCTIONAL_CLASS_DESCR,
                                      FEDERAL_URBAN_GROUP,
                                      FEDERAL_URBAN_GROUP_DESCR,
                                      FEDERAL_URBAN_RURAL,
                                      FEDERAL_URBAN_RURAL_DESCR,
                                      FUTURE_ADT,
                                      FUTURE_ADT_YEAR,
                                      HASS_DESCRIPTION,
                                      HASS_ID,
                                      HIGHWAY_ID,
                                      HPMS_SECTION_ID,
                                      HPMT_COMB_AADT_PCNT,
                                      HPMT_COMB_DHV_PCNT,
                                      HPMT_DHV_PCNT,
                                      HPMT_DIR_DIST,
                                      HPMT_PASS_AADT_PCNT,
                                      HPMT_PASS_DHV_PCNT,
                                      HPMT_SU_AADT_PCNT,
                                      HPMT_SU_DHV_PCNT,
                                      HUNDRED_MILLION_VEHICLE_MILES,
                                      INJURY_COUNT,
                                      INJURY_LEVEL,
                                      INJURY_LEVEL_CODE,
                                      IRI,
                                      JURISDICTION,
                                      JURISDICTION_ABBREVIATION,
                                      JURISDICTION_CODE,
                                      LANE_COUNT,
                                      LANE_SURFACE_TYPE,
                                      LANE_SURFACE_TYPE_DESCR,
                                      LAST_TREATMENT_PSN,
                                      LATITUDE,
                                      LEFT_LANE_CROSSSECTION,
                                      LEFT_RUT,
                                      LEFT_SHOULDER_TYPE,
                                      LEFT_SHOULDER_TYPE_DESCR,
                                      LEFT_SHOULDER_WIDTH,
                                      LEFT_SIDEWALK_TYPE,
                                      LEFT_SIDEWALK_TYPE_DESCR,
                                      LEFT_SIDEWALK_WIDTH,
                                      LEFT_TURN_LANE_COUNT,
                                      LEFT_TURN_LANE_WIDTH,
                                      LIGHT_CONDITION,
                                      LIGHT_CONDITION_DESCR,
                                      LOCATION_TYPE,
                                      LOC_FIRST_HARMFUL_EVENT,
                                      LOC_FIRST_HARMFUL_EVENT_DESCR,
                                      LONGITUDE,
                                      MAINTENANCE_REGION,
                                      MAINTENANCE_REGION_DESCR,
                                      MAINT_RESP_WINTER,
                                      MAINT_RESP_WINTER_DESCR,
                                      MAINT_RESP_YEARROUND,
                                      MAINT_RESP_YEAR_DESCR,
                                      MDOT_LAST_MODIFIED,
                                      MDOT_REVIEW_COMMENT,
                                      MDOT_REVIEW_DATE,
                                      MDOT_REVIEWER_ID,
                                      MDOTID,
                                      MEAN_SUM_DEFLECTION_CSL,
                                      MEDIAN_AVERAGE_WIDTH,
                                      MEDIAN_TYPE,
                                      MEDIAN_TYPE_DESCR,
                                      MEV,
                                      MILEPOINT,
                                      MIN_PAVEMENT_WIDTH_CSL,
                                      MIN_STRUCT_BRIDGE_COND_CSL,
                                      MOTORCYCLE_YN,
                                      MPO,
                                      NATIONAL_TRUCK_NETWORK,
                                      NATIONAL_TRUCK_NETWORK_DESCR,
                                      NHFN_CONNECTOR_ID,
                                      NHFN_SUBSYSTEM,
                                      NHFN_SUBSYSTEM_DESCR,
                                      NHS_STATUS,
                                      NHS_TYPE,
                                      NHS_TYPE_DESCR,
                                      NODE_DESCRIPTION,
                                      NODE_ID,
                                      NO_OF_A_INJ,
                                      NO_OF_B_INJ,
                                      NO_OF_C_INJ,
                                      NO_OF_K_INJ,
                                      NO_OF_LEGS,
                                      NO_OF_NON_INJ,
                                      NO_OF_PERSONS,
                                      NO_OF_UNITS,
                                      NUMBER_OF_LANES,
                                      OFFICIAL_MILES,
                                      OFFSET,
                                      ONE_WAY,
                                      ONE_WAY_DESCR,
                                      OWNER,
                                      OWNER_DESCR,
                                      PAVEMENT_CONDITION_CSL,
                                      PAVEMENT_RUTTING_CSL,
                                      PAVEMENT_WIDTH_CSL,
                                      PCR,
                                      PEDESTRIAN_YN,
                                      PLOW_CREW,
                                      PMS_FILE_NAME,
                                      PMS_INVENTORY_YEAR,
                                      PRIMARY,
                                      PRIMARY_ROUTE_MP,
                                      PRIMARY_ROUTE_NAME,
                                      PRIMARY_ROUTE_NUMBER,
                                      PRIORITY,
                                      RAMP,
                                      RAMP_DESCR,
                                      REGION_CODE,
                                      REGION_NAME,
                                      REPORTING_AGENCY,
                                      REPORTING_AGENCY_DESCR,
                                      REPORT_NUMBER,
                                      RIDE_QUALITY_CSL,
                                      RIGHT_LANE_CROSSSECTION,
                                      RIGHT_RUT,
                                      RIGHT_SHOULDER_TYPE,
                                      RIGHT_SHOULDER_TYPE_DESCR,
                                      RIGHT_SHOULDER_WIDTH,
                                      RIGHT_SIDEWALK_TYPE,
                                      RIGHT_SIDEWALK_TYPE_DESCR,
                                      RIGHT_SIDEWALK_WIDTH,
                                      RIGHT_TURN_LANE_COUNT,
                                      RIGHT_TURN_LANE_WIDTH,
