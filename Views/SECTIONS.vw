           MEDIAN_AVERAGE_WIDTH,
           MEDIAN_TYPE,
           MEDIAN_TYPE_DESCR,
           MIN_PAVEMENT_WIDTH_CSL,
           MIN_STRUCT_BRIDGE_COND_CSL,
           MPO,
           NATIONAL_TRUCK_NETWORK,
           NATIONAL_TRUCK_NETWORK_DESCR,
           NHFN_CONNECTOR_ID,
           NHFN_SUBSYSTEM,
           NHFN_SUBSYSTEM_DESCR,
           NHS_STATUS,
           NHS_TYPE,
           NHS_TYPE_DESCR,
