           OWNER_DESCR,
           PAVEMENT_CONDITION_CSL,
           PAVEMENT_RUTTING_CSL,
           PAVEMENT_WIDTH_CSL,
           PCR,
           PLOW_CREW,
           PMS_FILE_NAME,
           PMS_INVENTORY_YEAR,
           PRIORITY,
           RIDE_QUALITY_CSL,
           RIGHT_RUT,
           RIGHT_TURN_LANE_COUNT,
           RIGHT_TURN_LANE_WIDTH,
