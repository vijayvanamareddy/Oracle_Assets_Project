                    a.WORKZONE_IN_OR_NEAR,
                    a.WORKZONE_IN_OR_NEAR_DESCR,
                    a.WORKZONE_LOCATION,
                    a.WORKZONE_LOCATION_DESCR,
                    a.WORKZONE_POLICE_PRESENT,
                    a.WORKZONE_POLICE_PRESENT_DESCR,
                    a.WORKZONE_TYPE,
                    a.WORKZONE_TYPE_DESCR,
                    a.WORKZONE_WORKERS_PRESENT,
                    a.WORKZONE_WORKERS_PRESENT_DESCR,
                    nodes.MEV                             AS NODES_MEV,
                    nodes.NODE_ID                         AS NODES_NODE_ID,
                    nodes.NO_OF_LEGS                      AS nodes_no_of_legs,
                    nodes.NODE_DESCRIPTION                AS nodes_node_description,
                    nodes.TOWN_CODE1                      AS nodes_town_code1,
                    nodes.TOWN_CODE2                      AS nodes_town_code2,
                    nodes.TOWN_NAME1                      AS nodes_town_name1,
                    nodes.TOWN_NAME2                      AS nodes_town_name2,
                    nodes.TOWNLINE_NODE                   AS nodes_townline_node,
                    nodes.TRAFFIC_SIGNAL                  AS nodes_traffic_signal,
                    2023                                  AS CRASH_SUBSET,
                    EXTRACT (YEAR FROM accident_date)     AS accident_year
               FROM CRASHES_ON_ROUTE_2023  a
                    LEFT OUTER JOIN NODES_history nodes
                        ON     a.NODE_ID = NODES.NODE_ID
                           AND nodes.snapshot_year = 2023
                           AND nodes.state = 'PAST'
              WHERE     a.ROUTE_NUMBER = a.PRIMARY_ROUTE_NUMBER
                    AND EXTRACT (YEAR FROM accident_date) = 2023
            UNION ALL
            SELECT a.MDOTID,
                    a.PRIMARY_ROUTE_NAME,
                    a.PRIMARY_ROUTE_NUMBER,
                    a.PRIMARY_ROUTE_MP,
                    a.AADT,
                    a.ACCIDENT_DATE,
                    a.ACCIDENT_DAY_OF_WEEK,
                    a.ACCIDENT_DAY_OF_WEEK_NUM,
                    a.ACCIDENT_HOUR,
                    a.ACCIDENT_MONTH_NAME,
                    a.ACCIDENT_MONTH_NUM,
                    a.ACCIDENT_TIME,
                    a.BEGIN_ELEMENT_MILEPOINT,
                    a.BEGIN_SECTION_MP,
                    a.BEGIN_SECTION_OFFSET,
                    a.CAPACITY,
                    a.CONTRIB_CIRC_ENV1,
                    a.CONTRIB_CIRC_ENV1_DESCR,
                    a.CONTRIB_CIRC_ENV2,
                    a.CONTRIB_CIRC_ENV2_DESCR,
                    a.CONTRIB_CIRC_ROAD1,
                    a.CONTRIB_CIRC_ROAD1_DESCR,
                    a.CONTRIB_CIRC_ROAD2,
                    a.CONTRIB_CIRC_ROAD2_DESCR,
                    a.COUNTY_CODE,
                    a.COUNTY_NAME,
                    a.DIRECTIONAL_SUFFIX,
