           "ONE_WAY",
           "ONE_WAY_DESCR",
           "RAMP",
           "RAMP_DESCR",
           "REGION_CODE",
           "REGION_NAME",
           "REPORT_NUMBER",
           "REPORTING_AGENCY",
           "REPORTING_AGENCY_DESCR",
           "RIGHT_SHOULDER_TYPE",
           "RIGHT_SHOULDER_TYPE_DESCR",
           "RIGHT_SHOULDER_WIDTH",
           "ROAD_GRADE",
           "ROAD_GRADE_DESCR",
           "ROAD_SURF_COND",
           "ROAD_SURF_COND_DESCR",
           "ROADWAY_TYPE",
           "ROUTE_NAME",
           "ROUTE_NUMBER",
           "ROUTE_SYSTEM",
           "SCENIC_BYWAY_DESCRIPTION",
           "SCENIC_BYWAY_DESIG_YR",
           "SCENIC_BYWAY_NAME",
           "SCENIC_BYWAY_TYPE",
           "SCENIC_BYWAY_TYPE_DESCR",
           "SCHOOL_BUS_RELATED",
           "SCHOOL_BUS_RELATED_DESCR",
           "SECTION_ID",
           "SECTION_LENGTH",
           "SPEED",
           "SPEED_LIMIT",
           "STATE_DESIG_TYPE",
           "STATE_DESIG_TYPE_DESCR",
           "STATE_URBAN_RURAL",
           "STATE_URBAN_RURAL_DESCR",
           "STREET_NAME",
           "STREET_NAME_PREFIX",
           "STREET_NAME_SUFFIX",
           "TOTAL_PAVEMENT_WIDTH",
           "TOWN_CODE",
           "TOWN_NAME",
           "TRAFFIC_CONTROL_DEVICE",
           "TRAFFIC_CONTROL_DEVICE_DESCR",
           "TRF_CNTRL_DEV_OPRATIONL",
           "TRF_CNTRL_DEV_OPRATIONL_DESCR",
           "TRUCK_PERCENT",
           "TYPE_OF_CRASH",
           "TYPE_OF_CRASH_DESCR",
           "TYPE_OF_LOCATION",
           "TYPE_OF_LOCATION_DESCR",
           "WEATHER_CONDITION",
           "WEATHER_CONDITION_DESCR",
           "WIDTH",
           "WORKZONE_IN_OR_NEAR",
           "WORKZONE_IN_OR_NEAR_DESCR",
           "WORKZONE_LOCATION",
           "WORKZONE_LOCATION_DESCR",
           "WORKZONE_POLICE_PRESENT",
           "WORKZONE_POLICE_PRESENT_DESCR",
           "WORKZONE_TYPE",
           "WORKZONE_TYPE_DESCR",
           "WORKZONE_WORKERS_PRESENT",
           "WORKZONE_WORKERS_PRESENT_DESCR",
           "NODES_MEV",
           "NO_OF_LEGS",
           "NODE_DESCRIPTION",
           "TOWN_CODE1",
           "TOWN_CODE2",
           "TOWN_NAME1",
           "TOWN_NAME2",
           "TOWNLINE_NODE",
           "TRAFFIC_SIGNAL",
           "ACCIDENT_YEAR",
           "CRASH_SUBSET"
      FROM (SELECT CAST (
                       ROW_NUMBER ()
                           OVER (
                               ORDER BY CRASH_SUBSET, ACCIDENT_YEAR, MDOTID)
                           AS NUMBER (9))    AS uniqueid,
                   MDOTID,
                   CASE
                       WHEN (UPPER (MDOTID) LIKE '%C')
                       THEN
                              SUBSTR (MDOTID, 1, 5)
                           || LPAD (SUBSTR (MDOTID, 6), 6, '0')
                       ELSE
                              SUBSTR (MDOTID, 1, 5)
                           || LPAD (SUBSTR (MDOTID, 6), 5, '0')
                   END                       AS GIS_crash_id,
                   PRIMARY_ROUTE_NAME,
                   PRIMARY_ROUTE_NUMBER,
                   PRIMARY_ROUTE_MP,
                   AADT,
                   ACCIDENT_DATE,
                   ACCIDENT_DAY_OF_WEEK,
                   ACCIDENT_DAY_OF_WEEK_NUM,
                   ACCIDENT_HOUR,
                   ACCIDENT_MONTH_NAME,
                   ACCIDENT_MONTH_NUM,
                   ACCIDENT_TIME,
                   BEGIN_ELEMENT_MILEPOINT,
                   BEGIN_SECTION_MP,
                   BEGIN_SECTION_OFFSET,
                   CAPACITY,
                   CONTRIB_CIRC_ENV1,
                   CONTRIB_CIRC_ENV1_DESCR,
                   CONTRIB_CIRC_ENV2,
                   CONTRIB_CIRC_ENV2_DESCR,
                   CONTRIB_CIRC_ROAD1,
                   CONTRIB_CIRC_ROAD1_DESCR,
                   CONTRIB_CIRC_ROAD2,
                   CONTRIB_CIRC_ROAD2_DESCR,
                   COUNTY_CODE,
                   COUNTY_NAME,
                   DIRECTIONAL_SUFFIX,
                   ELEMENT_ID,
                   ELEMENT_LENGTH,
                   ELEMENT_WID,
                   END_ELEMENT_MILEPOINT,
                   END_SECTION_MP,
                   END_SECTION_OFFSET,
                   EXISTING,
                   FACTOR_YEAR,
                   FACTORED_AADT,
                   FEDERAL_FUNCTIONAL_CLASS,
                   FEDERAL_FUNCTIONAL_CLASS_DESCR,
                   FEDERAL_URBAN_GROUP,
                   FEDERAL_URBAN_GROUP_DESCR,
                   FUTURE_ADT,
                   FUTURE_ADT_YEAR,
                   HASS_DESCRIPTION,
                   HUNDRED_MILLION_VEHICLE_MILES,
                   INJURY_COUNT,
                   INJURY_LEVEL,
                   INJURY_LEVEL_CODE,
                   JURISDICTION,
                   LANE_COUNT,
                   LATITUDE,
                   LONGITUDE,
                   LEFT_SHOULDER_TYPE,
                   LEFT_SHOULDER_TYPE_DESCR,
                   LEFT_SHOULDER_WIDTH,
                   LIGHT_CONDITION,
                   LIGHT_CONDITION_DESCR,
                   LOC_FIRST_HARMFUL_EVENT,
                   LOC_FIRST_HARMFUL_EVENT_DESCR,
                   LOCATION_TYPE,
                   MEDIAN_AVERAGE_WIDTH,
                   MEDIAN_TYPE,
                   MEDIAN_TYPE_DESCR,
                   CRASHES_ON_ROUTE_MEV,
                   NATIONAL_TRUCK_NETWORK,
                   NATIONAL_TRUCK_NETWORK_DESCR,
                   NHS_STATUS,
                   NO_OF_A_INJ,
                   NO_OF_B_INJ,
                   NO_OF_C_INJ,
                   NO_OF_K_INJ,
                   NO_OF_NON_INJ,
                   COR_NODE_ID,
                   NUMBER_OF_LANES,
                   OFFSET,
                   ONE_WAY,
                   ONE_WAY_DESCR,
                   RAMP,
                   RAMP_DESCR,
                   REGION_CODE,
                   REGION_NAME,
                   REPORT_NUMBER,
                   REPORTING_AGENCY,
                   REPORTING_AGENCY_DESCR,
                   RIGHT_SHOULDER_TYPE,
                   RIGHT_SHOULDER_TYPE_DESCR,
                   RIGHT_SHOULDER_WIDTH,
                   ROAD_GRADE,
                   ROAD_GRADE_DESCR,
                   ROAD_SURF_COND,
                   ROAD_SURF_COND_DESCR,
                   ROADWAY_TYPE,
                   ROUTE_NAME,
                   ROUTE_NUMBER,
                   ROUTE_SYSTEM,
                   SCENIC_BYWAY_DESCRIPTION,
                   SCENIC_BYWAY_DESIG_YR,
                   SCENIC_BYWAY_NAME,
                   SCENIC_BYWAY_TYPE,
                   SCENIC_BYWAY_TYPE_DESCR,
                   SCHOOL_BUS_RELATED,
                   SCHOOL_BUS_RELATED_DESCR,
                   SECTION_ID,
                   SECTION_LENGTH,
                   SPEED,
                   SPEED_LIMIT,
                   STATE_DESIG_TYPE,
                   STATE_DESIG_TYPE_DESCR,
                   STATE_URBAN_RURAL,
                   STATE_URBAN_RURAL_DESCR,
                   STREET_NAME,
                   STREET_NAME_PREFIX,
                   STREET_NAME_SUFFIX,
                   TOTAL_PAVEMENT_WIDTH,
                   TOWN_CODE,
                   TOWN_NAME,
                   TRAFFIC_CONTROL_DEVICE,
                   TRAFFIC_CONTROL_DEVICE_DESCR,
                   TRF_CNTRL_DEV_OPRATIONL,
                   TRF_CNTRL_DEV_OPRATIONL_DESCR,
                   TRUCK_PERCENT,
                   TYPE_OF_CRASH,
                   TYPE_OF_CRASH_DESCR,
                   TYPE_OF_LOCATION,
                   TYPE_OF_LOCATION_DESCR,
                   WEATHER_CONDITION,
                   WEATHER_CONDITION_DESCR,
                   WIDTH,
                   WORKZONE_IN_OR_NEAR,
                   WORKZONE_IN_OR_NEAR_DESCR,
                   WORKZONE_LOCATION,
                   WORKZONE_LOCATION_DESCR,
                   WORKZONE_POLICE_PRESENT,
                   WORKZONE_POLICE_PRESENT_DESCR,
                   WORKZONE_TYPE,
                   WORKZONE_TYPE_DESCR,
                   WORKZONE_WORKERS_PRESENT,
                   WORKZONE_WORKERS_PRESENT_DESCR,
                   nodes_MEV                 NODES_MEV,
                   nodes_NO_OF_LEGS          AS no_of_legs,
                   nodes_NODE_DESCRIPTION    AS node_description,
                   nodes_TOWN_CODE1          AS town_code1,
                   nodes_TOWN_CODE2          AS town_code2,
                   nodes_TOWN_NAME1          AS town_name1,
                   nodes_TOWN_NAME2          AS town_name2,
                   nodes_TOWNLINE_NODE       AS townline_node,
                   nodes_TRAFFIC_SIGNAL      AS traffic_signal,
                   accident_year,
                   crash_subset
              FROM hsiscrashes) --where CRASH_SUBSET=2018 and accident_year = 2017
;
