CREATE OR REPLACE VIEW WH_ASSETS.V_HSIS_CRASH_HISTORIC
BEQUEATH DEFINER
AS 
WITH
        hsiscrashes
        AS
            (
            SELECT a.MDOTID,
                    a.PRIMARY_ROUTE_NAME,
                    a.PRIMARY_ROUTE_NUMBER,
                    a.PRIMARY_ROUTE_MP,
                    a.AADT,
                    a.ACCIDENT_DATE,
                    a.ACCIDENT_DAY_OF_WEEK,
                    a.ACCIDENT_DAY_OF_WEEK_NUM,
                    a.ACCIDENT_HOUR,
                    a.ACCIDENT_MONTH_NAME,
                    a.ACCIDENT_MONTH_NUM,
                    a.ACCIDENT_TIME,
                    a.BEGIN_ELEMENT_MILEPOINT,
                    a.BEGIN_SECTION_MP,
                    a.BEGIN_SECTION_OFFSET,
                    a.CAPACITY,
                    a.CONTRIB_CIRC_ENV1,
                    a.CONTRIB_CIRC_ENV1_DESCR,
                    a.CONTRIB_CIRC_ENV2,
                    a.CONTRIB_CIRC_ENV2_DESCR,
                    a.CONTRIB_CIRC_ROAD1,
                    a.CONTRIB_CIRC_ROAD1_DESCR,
                    a.CONTRIB_CIRC_ROAD2,
                    a.CONTRIB_CIRC_ROAD2_DESCR,
                    a.COUNTY_CODE,
                    a.COUNTY_NAME,
                    a.DIRECTIONAL_SUFFIX,
                    a.ELEMENT_ID,
                    a.ELEMENT_LENGTH,
                    a.ELEMENT_WID,
                    a.END_ELEMENT_MILEPOINT,
                    a.END_SECTION_MP,
                    a.END_SECTION_OFFSET,
                    a.EXISTING,
                    a.FACTOR_YEAR,
                    a.FACTORED_AADT,
                    a.FEDERAL_FUNCTIONAL_CLASS,
                    a.FEDERAL_FUNCTIONAL_CLASS_DESCR,
                    a.FEDERAL_URBAN_GROUP,
                    a.FEDERAL_URBAN_GROUP_DESCR,
                    a.FUTURE_ADT,
                    a.FUTURE_ADT_YEAR,
                    a.HASS_DESCRIPTION,
                    a.HUNDRED_MILLION_VEHICLE_MILES,
                    a.INJURY_COUNT,
                    a.INJURY_LEVEL,
                    a.INJURY_LEVEL_CODE,
                    a.JURISDICTION,
                    a.LANE_COUNT,
                    a.LATITUDE,
                    a.LONGITUDE,
                    a.LEFT_SHOULDER_TYPE,
                    a.LEFT_SHOULDER_TYPE_DESCR,
                    a.LEFT_SHOULDER_WIDTH,
                    a.LIGHT_CONDITION,
                    a.LIGHT_CONDITION_DESCR,
                    a.LOC_FIRST_HARMFUL_EVENT,
                    a.LOC_FIRST_HARMFUL_EVENT_DESCR,
                    a.LOCATION_TYPE,
                    a.MEDIAN_AVERAGE_WIDTH,
                    a.MEDIAN_TYPE,
                    a.MEDIAN_TYPE_DESCR,
                    a.MEV                                 AS CRASHES_ON_ROUTE_MEV,
                    a.NATIONAL_TRUCK_NETWORK,
                    a.NATIONAL_TRUCK_NETWORK_DESCR,
                    a.NHS_STATUS,
                    a.NO_OF_A_INJ,
                    a.NO_OF_B_INJ,
                    a.NO_OF_C_INJ,
                    a.NO_OF_K_INJ,
                    a.NO_OF_NON_INJ,
                    a.NODE_ID                             AS COR_NODE_ID,
                    a.NUMBER_OF_LANES,
                    a.OFFSET,
                    a.ONE_WAY,
                    a.ONE_WAY_DESCR,
                    a.RAMP,
                    a.RAMP_DESCR,
                    a.REGION_CODE,
                    a.REGION_NAME,
                    a.REPORT_NUMBER,
                    a.REPORTING_AGENCY,
                    a.REPORTING_AGENCY_DESCR,
                    a.RIGHT_SHOULDER_TYPE,
                    a.RIGHT_SHOULDER_TYPE_DESCR,
                    a.RIGHT_SHOULDER_WIDTH,
                    a.ROAD_GRADE,
                    a.ROAD_GRADE_DESCR,
                    a.ROAD_SURF_COND,
                    a.ROAD_SURF_COND_DESCR,
                    a.ROADWAY_TYPE,
                    a.ROUTE_NAME,
                    a.ROUTE_NUMBER,
                    a.ROUTE_SYSTEM,
                    a.SCENIC_BYWAY_DESCRIPTION,
                    a.SCENIC_BYWAY_DESIG_YR,
                    a.SCENIC_BYWAY_NAME,
                    a.SCENIC_BYWAY_TYPE,
                    a.SCENIC_BYWAY_TYPE_DESCR,
                    a.SCHOOL_BUS_RELATED,
                    a.SCHOOL_BUS_RELATED_DESCR,
                    a.SECTION_ID,
                    a.SECTION_LENGTH,
                    a.SPEED,
                    a.SPEED_LIMIT,
                    a.STATE_DESIG_TYPE,
                    a.STATE_DESIG_TYPE_DESCR,
                    a.STATE_URBAN_RURAL,
                    a.STATE_URBAN_RURAL_DESCR,
                    a.STREET_NAME,
                    a.STREET_NAME_PREFIX,
                    a.STREET_NAME_SUFFIX,
                    a.TOTAL_PAVEMENT_WIDTH,
                    a.TOWN_CODE,
                    a.TOWN_NAME,
                    a.TRAFFIC_CONTROL_DEVICE,
                    a.TRAFFIC_CONTROL_DEVICE_DESCR,
                    a.TRF_CNTRL_DEV_OPRATIONL,
                    a.TRF_CNTRL_DEV_OPRATIONL_DESCR,
                    a.TRUCK_PERCENT,
                    a.TYPE_OF_CRASH,
                    a.TYPE_OF_CRASH_DESCR,
                    a.TYPE_OF_LOCATION,
                    a.TYPE_OF_LOCATION_DESCR,
                    a.WEATHER_CONDITION,
                    a.WEATHER_CONDITION_DESCR,
                    a.WIDTH,
                    a.WORKZONE_IN_OR_NEAR,
                    a.WORKZONE_IN_OR_NEAR_DESCR,
                    a.WORKZONE_LOCATION,
                    a.WORKZONE_LOCATION_DESCR,
                    a.WORKZONE_POLICE_PRESENT,
                    a.WORKZONE_POLICE_PRESENT_DESCR,
                    a.WORKZONE_TYPE,
                    a.WORKZONE_TYPE_DESCR,
                    a.WORKZONE_WORKERS_PRESENT,
                    a.WORKZONE_WORKERS_PRESENT_DESCR,
                    nodes.MEV                             AS NODES_MEV,
                    nodes.NODE_ID                         AS NODES_NODE_ID,
                    nodes.NO_OF_LEGS                      AS nodes_no_of_legs,
                    nodes.NODE_DESCRIPTION                AS nodes_node_description,
                    nodes.TOWN_CODE1                      AS nodes_town_code1,
                    nodes.TOWN_CODE2                      AS nodes_town_code2,
                    nodes.TOWN_NAME1                      AS nodes_town_name1,
                    nodes.TOWN_NAME2                      AS nodes_town_name2,
                    nodes.TOWNLINE_NODE                   AS nodes_townline_node,
                    nodes.TRAFFIC_SIGNAL                  AS nodes_traffic_signal,
                    2024                                  AS CRASH_SUBSET,
                    EXTRACT (YEAR FROM accident_date)     AS accident_year
               FROM CRASHES_ON_ROUTE_2024  a
                    LEFT OUTER JOIN NODES_history nodes
                        ON     a.NODE_ID = NODES.NODE_ID
                           AND nodes.snapshot_year = 2024
                           AND nodes.state = 'PAST'
              WHERE     a.ROUTE_NUMBER = a.PRIMARY_ROUTE_NUMBER
                    AND EXTRACT (YEAR FROM accident_date) = 2024
            UNION ALL
            SELECT a.MDOTID,
                    a.PRIMARY_ROUTE_NAME,
                    a.PRIMARY_ROUTE_NUMBER,
                    a.PRIMARY_ROUTE_MP,
                    a.AADT,
                    a.ACCIDENT_DATE,
                    a.ACCIDENT_DAY_OF_WEEK,
                    a.ACCIDENT_DAY_OF_WEEK_NUM,
                    a.ACCIDENT_HOUR,
                    a.ACCIDENT_MONTH_NAME,
                    a.ACCIDENT_MONTH_NUM,
                    a.ACCIDENT_TIME,
                    a.BEGIN_ELEMENT_MILEPOINT,
                    a.BEGIN_SECTION_MP,
                    a.BEGIN_SECTION_OFFSET,
                    a.CAPACITY,
                    a.CONTRIB_CIRC_ENV1,
                    a.CONTRIB_CIRC_ENV1_DESCR,
                    a.CONTRIB_CIRC_ENV2,
                    a.CONTRIB_CIRC_ENV2_DESCR,
                    a.CONTRIB_CIRC_ROAD1,
                    a.CONTRIB_CIRC_ROAD1_DESCR,
                    a.CONTRIB_CIRC_ROAD2,
                    a.CONTRIB_CIRC_ROAD2_DESCR,
                    a.COUNTY_CODE,
                    a.COUNTY_NAME,
                    a.DIRECTIONAL_SUFFIX,
                    a.ELEMENT_ID,
                    a.ELEMENT_LENGTH,
                    a.ELEMENT_WID,
                    a.END_ELEMENT_MILEPOINT,
                    a.END_SECTION_MP,
                    a.END_SECTION_OFFSET,
                    a.EXISTING,
                    a.FACTOR_YEAR,
                    a.FACTORED_AADT,
                    a.FEDERAL_FUNCTIONAL_CLASS,
