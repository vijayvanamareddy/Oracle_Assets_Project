CREATE OR REPLACE VIEW WH_ASSETS.V_HSIS_ROADWAY_SEGMENTS_HIST
BEQUEATH DEFINER
AS 
SELECT "ROUTE_NUMBER","BEGIN_SECTION_MP","END_SECTION_MP","AADT","AADT_TYPE","AADT_TYPE_DESCR","AADT_YEAR","ABN","ABN_DESCR","ACCESS_CONTROL","ACCESS_CONTROL_DESCR","AGENCY","AGENCY_DESCR","BEGIN_ELEMENT_MILEPOINT","BEGIN_NODE_DESCRIPTION","BEGIN_NODE_ID","CAPACITY","CENTER_TURN_LANE_COUNT","CENTER_TURN_LANE_WIDTH","COUNTY_CODE","COUNTY_NAME","CUMULATIVE_MILEPOINT_ORDER","DIRECTION","DIRECTIONAL_SUFFIX","ELEMENT_ID","ELEMENT_LENGTH","END_ELEMENT_MILEPOINT","END_NODE_DESCRIPTION","END_NODE_ID","EXISTING","FACTORED_AADT","FACTOR_GROUP","FACTOR_YEAR","FEDERAL_FUNCTIONAL_CLASS","FEDERAL_FUNCTIONAL_CLASS_DESCR","FEDERAL_URBAN_GROUP","FEDERAL_URBAN_GROUP_DESCR","FEDERAL_URBAN_RURAL","FEDERAL_URBAN_RURAL_DESCR","FUTURE_ADT","FUTURE_ADT_YEAR","GEOGRAPHIC_AREA_TYPE","GEOGRAPHIC_AREA_TYPE_DESCR","HASS_DESCRIPTION","HASS_ID","HPMS_SECTION_ID","JURISDICTION","JURISDICTION_ABBREVIATION","JURISDICTION_CODE","LANE_COUNT","LANE_SURFACE_TYPE","LANE_SURFACE_TYPE_DESCR","LEFT_LANE_CROSSSECTION","LEFT_SHOULDER_TYPE","LEFT_SHOULDER_TYPE_DESCR","LEFT_SHOULDER_WIDTH","LEFT_SIDEWALK_TYPE","LEFT_SIDEWALK_TYPE_DESCR","LEFT_SIDEWALK_WIDTH","LEFT_TURN_LANE_COUNT","LEFT_TURN_LANE_WIDTH","MAINTENANCE_REGION","MAINTENANCE_REGION_DESCR","MAINT_RESP_WINTER","MAINT_RESP_WINTER_DESCR","MAINT_RESP_YEARROUND","MAINT_RESP_YEAR_DESCR","MEDIAN_AVERAGE_WIDTH","MEDIAN_TYPE","MEDIAN_TYPE_DESCR","MPO","NATIONAL_TRUCK_NETWORK","NATIONAL_TRUCK_NETWORK_DESCR","NHS_STATUS","NHS_TYPE","NHS_TYPE_DESCR","NODE_DESCRIPTION","OFFICIAL_MILES","ONE_WAY","ONE_WAY_DESCR","OWNER","OWNER_DESCR","PLOW_CREW","PRIMARY","PRIMARY_ROUTE_NUMBER","PRIORITY","RAMP","RAMP_DESCR","RIGHT_LANE_CROSSSECTION","RIGHT_SHOULDER_TYPE","RIGHT_SHOULDER_TYPE_DESCR","RIGHT_SHOULDER_WIDTH","RIGHT_SIDEWALK_TYPE","RIGHT_SIDEWALK_TYPE_DESCR","RIGHT_SIDEWALK_WIDTH","RIGHT_TURN_LANE_COUNT","RIGHT_TURN_LANE_WIDTH","ROADWAY_TYPE","ROADWAY_TYPE_DESCR","ROUTE_GROUP","ROUTE_NAME","ROUTE_SYSTEM","ROUTE_TYPE","SCENIC_BYWAY_DESCRIPTION","SCENIC_BYWAY_DESIG_YR","SCENIC_BYWAY_NAME","SCENIC_BYWAY_TYPE","SCENIC_BYWAY_TYPE_DESCR","SH_SA_IR_DESIGNATION","SNAPSHOT_YEAR","SPEED","SPEEDSRC","STATE_DESIG_TYPE","STATE_DESIG_TYPE_DESCR","STATE_URBAN_RURAL","STATE_URBAN_RURAL_DESCR","STRATEGIC_HIGHWAY_NETWORK","STRATEGIC_HIGHWAY_NETWORK_DESC","STREETNAME","SUMMER_CREW","THRU_LANE_COUNT","THRU_LANE_WIDTH","TOTAL_PAVEMENT_WIDTH","TOWN_CODE","TOWN_NAME","TRANSPORTATION_MODE","TRUCK_LANE_COUNT","TRUCK_LANE_WIDTH","WIDTH","WINTER_CREW","SEGMENT_ID" FROM (
    SELECT A."ROUTE_NUMBER",
           A."BEGIN_SECTION_MP",
           A."END_SECTION_MP",
           A."AADT",
           A."AADT_TYPE",
           A."AADT_TYPE_DESCR",
           A."AADT_YEAR",
           A."ABN",
           A."ABN_DESCR",
           A."ACCESS_CONTROL",
           A."ACCESS_CONTROL_DESCR",
           A."AGENCY",
           A."AGENCY_DESCR",
           A."BEGIN_ELEMENT_MILEPOINT",
           A."BEGIN_NODE_DESCRIPTION",
           A."BEGIN_NODE_ID",
           A."CAPACITY",
           A."CENTER_TURN_LANE_COUNT",
           A."CENTER_TURN_LANE_WIDTH",
           A."COUNTY_CODE",
           A."COUNTY_NAME",
           A."CUMULATIVE_MILEPOINT_ORDER",
           A."DIRECTION",
           A."DIRECTIONAL_SUFFIX",
           A."ELEMENT_ID",
           A."ELEMENT_LENGTH",
           A."END_ELEMENT_MILEPOINT",
           A."END_NODE_DESCRIPTION",
           A."END_NODE_ID",
           A."EXISTING",
           A."FACTORED_AADT",
           A."FACTOR_GROUP",
           A."FACTOR_YEAR",
           A."FEDERAL_FUNCTIONAL_CLASS",
           A."FEDERAL_FUNCTIONAL_CLASS_DESCR",
           A."FEDERAL_URBAN_GROUP",
           A."FEDERAL_URBAN_GROUP_DESCR",
           A."FEDERAL_URBAN_RURAL",
           A."FEDERAL_URBAN_RURAL_DESCR",
           A."FUTURE_ADT",
           A."FUTURE_ADT_YEAR",
           A."GEOGRAPHIC_AREA_TYPE",
           A."GEOGRAPHIC_AREA_TYPE_DESCR",
           A."HASS_DESCRIPTION",
           A."HASS_ID",
           A."HPMS_SECTION_ID",
           A."JURISDICTION",
           A."JURISDICTION_ABBREVIATION",
           A."JURISDICTION_CODE",
           A."LANE_COUNT",
           A."LANE_SURFACE_TYPE",
           A."LANE_SURFACE_TYPE_DESCR",
           A."LEFT_LANE_CROSSSECTION",
           A."LEFT_SHOULDER_TYPE",
           A."LEFT_SHOULDER_TYPE_DESCR",
           A."LEFT_SHOULDER_WIDTH",
           A."LEFT_SIDEWALK_TYPE",
           A."LEFT_SIDEWALK_TYPE_DESCR",
           A."LEFT_SIDEWALK_WIDTH",
           A."LEFT_TURN_LANE_COUNT",
           A."LEFT_TURN_LANE_WIDTH",
           A."MAINTENANCE_REGION",
           A."MAINTENANCE_REGION_DESCR",
           A."MAINT_RESP_WINTER",
           A."MAINT_RESP_WINTER_DESCR",
           A."MAINT_RESP_YEARROUND",
           A."MAINT_RESP_YEAR_DESCR",
           A."MEDIAN_AVERAGE_WIDTH",
           A."MEDIAN_TYPE",
           A."MEDIAN_TYPE_DESCR",
           A."MPO",
           A."NATIONAL_TRUCK_NETWORK",
           A."NATIONAL_TRUCK_NETWORK_DESCR",
           A."NHS_STATUS",
           A."NHS_TYPE",
           A."NHS_TYPE_DESCR",
           A."NODE_DESCRIPTION",
           A."OFFICIAL_MILES",
           A."ONE_WAY",
           A."ONE_WAY_DESCR",
           A."OWNER",
           A."OWNER_DESCR",
           A."PLOW_CREW",
           A."PRIMARY",
           A."PRIMARY_ROUTE_NUMBER",
           A."PRIORITY",
           A."RAMP",
           A."RAMP_DESCR",
           A."RIGHT_LANE_CROSSSECTION",
           A."RIGHT_SHOULDER_TYPE",
           A."RIGHT_SHOULDER_TYPE_DESCR",
           A."RIGHT_SHOULDER_WIDTH",
           A."RIGHT_SIDEWALK_TYPE",
           A."RIGHT_SIDEWALK_TYPE_DESCR",
           A."RIGHT_SIDEWALK_WIDTH",
           A."RIGHT_TURN_LANE_COUNT",
           A."RIGHT_TURN_LANE_WIDTH",
           A."ROADWAY_TYPE",
           A."ROADWAY_TYPE_DESCR",
           A."ROUTE_GROUP",
           A."ROUTE_NAME",
           A."ROUTE_SYSTEM",
           A."ROUTE_TYPE",
           A."SCENIC_BYWAY_DESCRIPTION",
           A."SCENIC_BYWAY_DESIG_YR",
           A."SCENIC_BYWAY_NAME",
           A."SCENIC_BYWAY_TYPE",
           A."SCENIC_BYWAY_TYPE_DESCR",
           A."SH_SA_IR_DESIGNATION",
           A."SNAPSHOT_YEAR",
           A."SPEED",
           A."SPEEDSRC",
           A."STATE_DESIG_TYPE",
           A."STATE_DESIG_TYPE_DESCR",
           A."STATE_URBAN_RURAL",
           A."STATE_URBAN_RURAL_DESCR",
           A."STRATEGIC_HIGHWAY_NETWORK",
           A."STRATEGIC_HIGHWAY_NETWORK_DESC",
           A."STREETNAME",
           A."SUMMER_CREW",
           A."THRU_LANE_COUNT",
           A."THRU_LANE_WIDTH",
           A."TOTAL_PAVEMENT_WIDTH",
           A."TOWN_CODE",
           A."TOWN_NAME",
           A."TRANSPORTATION_MODE",
           A."TRUCK_LANE_COUNT",
           A."TRUCK_LANE_WIDTH",
           A."WIDTH",
           A."WINTER_CREW",
           CAST (ROW_NUMBER () OVER (ORDER BY SNAPSHOT_YEAR, ROUTE_NUMBER,  BEGIN_SECTION_MP) AS NUMBER(9))  AS SEGMENT_ID
      FROM MV_HSIS_ROADWAY_SEGMENTS_HIST A)
      ORDER BY SEGMENT_ID;
